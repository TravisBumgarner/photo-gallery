# Copy this file to .env.local or .env.production and fill in values.
# The ingestion script will prompt you to choose which environment to use.

# Only needed for local mode (ignored in production mode)
DATABASE_URL=../backend/sqlite.db
SOURCE_DIR=/path/to/photos
DESTINATION_DIRECTORY=../backend/public
INGEST_MODE=local
DRY_RUN=true
FILE_TRANSFER_MODE=copy
SSH_HOST=user@host

# Model server for content tagging (see README "Model Server")
MODEL_SERVER_HOST=http://192.168.1.63:4000
MODEL_SERVER_MODEL=Qwen/Qwen3.6-27B-FP8
MODEL_SERVER_API_KEY=sk-1234

# Face server for people search (see README "Face Server"). Local-only — face
# data never gets pushed to prod.
FACE_SERVER_HOST=http://127.0.0.1:8090
FACE_SERVER_API_KEY=
