{
  "name": "photo-gallery",
  "version": "1.0.0",
  "description": "Full-stack app with React Native (Expo), Express, and Drizzle ORM",
  "workspaces": [
    "shared",
    "backend",
    "offline-processing",
    "frontend",
    "cli"
  ],
  "scripts": {
    "setup": "bash bootstrap.sh",
    "orchestrator": "npm run start -w cli",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run start -w frontend",
    "dev:frontend-web": "npm run web -w frontend",
    "dev:frontend-ios": "npm run ios -w frontend",
    "build": "npm run build -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:studio": "npm run db:studio -w backend",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "deploy": "./deploy.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "concurrently": "^8.2.2"
  }
}
