# Copy to .env.local. Most values here are just remembered answers to ./oi's
# prompts (it writes your choices back to .env.local) — you don't need to fill
# them in by hand. Set SOURCE_DIR if you want a default; the rest is interactive.

# Only needed for local mode (ignored in production mode)
DATABASE_URL=../backend/sqlite.db
# The one folder to ingest — every image nested under it is processed. How you
# fill it (manual or Lightroom export) is a prep step; see README "Prepare the
# Photo Ingestion Directory".
SOURCE_DIR=/path/to/photos
# Lightroom users only: where your export preset writes (mixed with originals).
# ./prepare-lightroom moves the *_exported_for_viewing_locally copies from here
# into SOURCE_DIR before you run ./oi. Ignored for manual setups.
LIGHTROOM_DIR=/path/to/lightroom/exports
DESTINATION_DIRECTORY=../backend/public
INGEST_MODE=local
DRY_RUN=true
FILE_TRANSFER_MODE=copy
SSH_HOST=user@host

# --- Model servers (face/dog detection + the tagging LLM) ------------------
# All heavy model work runs on ONE machine. Leave COMPUTE_HOST as 'localhost' to
# run it here in Docker, or set another machine's IP/hostname. ./oi asks for this
# and writes your answer back here. The actual server URLs are derived from it.
COMPUTE_HOST=localhost
# Vision model for text tagging (the name your model server serves, e.g.
# 'llama3.2-vision' on a local Ollama). ./oi prompts for this.
MODEL_SERVER_MODEL=
# Optional bearer token for the model server (blank if none).
MODEL_SERVER_API_KEY=
