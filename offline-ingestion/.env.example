# Copy to .env.local. These are just remembered answers to ./oi's prompts —
# ./oi writes your choices back, so you mostly don't fill them in by hand.
# (Container paths, run flags, and tuning live in docker-compose.yml / the
# offline-ingestion.config.yaml; they don't belong here.)

# The one folder to ingest — every image nested under it is processed. See
# README "Prepare the Photo Ingestion Directory".
SOURCE_DIR=/path/to/photos

# Lightroom users only: where your export preset writes (mixed with originals).
# ./prepare-lightroom moves the *_exported_for_viewing_locally copies from here
# into SOURCE_DIR before you run ./oi. Ignored for manual setups.
LIGHTROOM_DIR=/path/to/lightroom/exports

# Where the model servers run: 'localhost' (this machine) or another machine's
# IP/hostname. ./oi asks for this; the server URLs are derived from it.
COMPUTE_HOST=localhost

# Vision model for text tagging (e.g. 'qwen3-vl:8b'). ./oi prompts for this.
MODEL_SERVER_MODEL=

# Remote model servers only: the auth gateway. On the SERVER box, './oi --server'
# generates GATEWAY_TOKEN and serves both model servers behind GATEWAY_PORT
# (default 8443). On the MAIN box you paste that token at the prompt; ./oi stores
# it here and sends it to both servers (so the two *_API_KEY fields mirror it).
# All blank for a purely local setup.
GATEWAY_TOKEN=
# GATEWAY_PORT=8443
MODEL_SERVER_API_KEY=
VISION_SERVER_API_KEY=
