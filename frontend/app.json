{
  "expo": {
    "name": "Your Own Gallery",
    "slug": "your-own-gallery",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yourowngallery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.travisbumgarner.yourowngallery",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.travisbumgarner.yourowngallery",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00d526d5-a2f1-4bec-aff0-c4da2f85140c"
      }
    },
    "owner": "tbumgarner"
  }
}
