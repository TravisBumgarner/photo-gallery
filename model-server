#!/usr/bin/env bash
# Turn THIS machine into the model server for another box. Brings up the native
# Ollama (GPU, for tagging) + the vision-server (faces/dogs) behind a single
# token-protected gateway, and prints the address + token to enter on the main
# machine (in ./ingest-and-sync's "tagging model" prompt). Nothing is ingested
# here — run ./ingest-and-sync on the machine that owns the photos.
#
#   ./model-server            bring the server up; keep the address + token on screen
#   ./model-server --verbose  also stream full Docker build logs, then stream live
#                             request logs (each tag / face / dog as it comes in)
#
# Needs only Docker (Compose v2) + bash. The token crosses the LAN in cleartext
# (plain HTTP) — fine on a trusted network; tunnel it (VPN/SSH) otherwise.
set -euo pipefail

# Compose lives in offline-processing/ and its paths are relative to it.
cd "$(dirname "$0")/offline-processing"

VERBOSE=false
for a in "$@"; do
  case "$a" in
    -v|--verbose) VERBOSE=true ;;
    -h|--help)
      cat <<'EOF'
Turn this machine into the model server for another box: bring up the native
Ollama (GPU, tagging) + the vision-server (faces/dogs) behind one token-protected
gateway, and print the address + token to enter on the main machine. Nothing is
ingested here — run ./ingest-and-sync where the photos are.

Usage:  ./model-server [--verbose]
  --verbose, -v   Stream the full Docker build logs (quiet by default), then
                  stream live request logs once up — each tagging, face, and dog
                  request from the main machine as it arrives. Default keeps the
                  address + token on screen and stays quiet (tail logs yourself).
EOF
      exit 0 ;;
    *) echo "Unknown option: $a" >&2; exit 1 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
dim()  { printf '\033[2m%s\033[0m\n' "$1"; }
err()  { printf '\033[31m%s\033[0m\n' "$1" >&2; }
ok()   { printf '\033[32m%s\033[0m\n' "$1"; }
ask()  { local p="$1" d="${2:-}" a; read -rp "$p" a; echo "${a:-$d}"; }
yes()  { local a; a=$(ask "$1 [y/N] " ""); [[ "$a" =~ ^[Yy] ]]; }

# docker compose build — silent by default; full plain logs with --verbose. When
# quiet, output is captured and only shown if the build actually fails.
compose_build() { # compose_build <service>...
  if [[ "$VERBOSE" == true ]]; then
    docker compose build --progress=plain "$@"
    return
  fi
  local log; log="$(mktemp)"
  if docker compose build "$@" >"$log" 2>&1; then
    rm -f "$log"
  else
    err "Build failed — output below (re-run with --verbose for live logs):"
    cat "$log"; rm -f "$log"; return 1
  fi
}

lan_ip() { # best-effort primary LAN IPv4 of this host (for the printed address)
  case "$(uname -s)" in
    Darwin) ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true ;;
    *)      hostname -I 2>/dev/null | awk '{print $1}' || true ;;
  esac
}

env_get() { # read KEY from .cli-cache
  [[ -f .cli-cache ]] && grep -E "^$1=" .cli-cache | tail -1 | cut -d= -f2- || true
}
env_set() { # persist KEY=VALUE to .cli-cache (so it's the next-run default)
  local key="$1" val="$2"
  touch .cli-cache
  grep -v -E "^${key}=" .cli-cache > .cli-cache.tmp 2>/dev/null || true
  printf '%s=%s\n' "$key" "$val" >> .cli-cache.tmp
  mv .cli-cache.tmp .cli-cache
}

# ----- native Ollama ---------------------------------------------------------
# Tagging runs the vision model on a NATIVE Ollama (it uses your GPU); a
# Dockerized CPU Ollama is unusably slow for vision work. The gateway (in
# Docker) reaches the host's Ollama via host.docker.internal, which needs a
# non-loopback bind, so we (re)bind it to 0.0.0.0 automatically.
native_ollama_up() {
  curl -fsS http://localhost:11434/api/tags  >/dev/null 2>&1 \
    || curl -fsS http://localhost:11434/v1/models >/dev/null 2>&1
}
native_has_model() { # <model> — already pulled into native Ollama?
  curl -fsS http://localhost:11434/api/tags 2>/dev/null | grep -q "\"$1\""
}
docker_ollama_ids() { docker ps -q --filter ancestor=ollama/ollama 2>/dev/null; }
ollama_loopback_only() { # listening on :11434 but only on loopback?
  local l; l="$(lsof -nP -iTCP:11434 -sTCP:LISTEN 2>/dev/null)" || return 1
  [[ -n "$l" ]] && ! grep -qE '(\*|0\.0\.0\.0):11434' <<<"$l"
}
ollama_serve_bound() {
  OLLAMA_HOST=0.0.0.0:11434 nohup ollama serve >/dev/null 2>&1 &
  disown 2>/dev/null || true
}
ollama_restart_bound() {
  if command -v ollama >/dev/null 2>&1; then
    pkill -ix ollama 2>/dev/null || true
    local t=0; while native_ollama_up; do [[ $t -ge 10 ]] && break; sleep 1; t=$((t + 1)); done
    ollama_serve_bound
  else
    launchctl setenv OLLAMA_HOST "0.0.0.0:11434" 2>/dev/null || true
    osascript -e 'quit app "Ollama"' >/dev/null 2>&1 || true
    local t=0; while native_ollama_up; do [[ $t -ge 10 ]] && break; sleep 1; t=$((t + 1)); done
    open -a Ollama >/dev/null 2>&1 || true
  fi
}
ensure_ollama_lan_bind() {
  ollama_loopback_only || return 0
  bold "Ollama is on 127.0.0.1 — rebinding to 0.0.0.0 so the gateway can reach it..."
  ollama_restart_bound
  printf "Restarting Ollama on 0.0.0.0:11434"
  local tries=0
  until native_ollama_up && ! ollama_loopback_only; do
    if [[ $tries -ge 20 ]]; then
      echo
      err "Couldn't get Ollama listening on 0.0.0.0:11434. Start it yourself with:"
      err "    OLLAMA_HOST=0.0.0.0:11434 ollama serve"
      err "leave it running, then run this again."
      exit 1
    fi
    printf "."; sleep 1; tries=$((tries + 1))
  done
  echo; ok "Ollama bound to 0.0.0.0:11434."
}
ensure_native_ollama() {
  local ids; ids="$(docker_ollama_ids)"
  if [[ -n "$ids" ]]; then
    echo
    err "A Dockerized (CPU) Ollama is running on :11434 — it's the slow one we no"
    err "longer use, and it hides your native GPU Ollama."
    if yes "Stop and remove it now?"; then
      docker rm -f $ids >/dev/null 2>&1 || true
      ok "Removed the Docker Ollama."
    else
      err "Remove it and re-run:  docker rm -f $ids"
      exit 1
    fi
  fi
  if ! native_ollama_up; then
    if command -v ollama >/dev/null 2>&1; then
      bold "Starting native Ollama, bound to 0.0.0.0 for the gateway..."
      ollama_serve_bound
    else
      echo
      err "Native Ollama isn't running, and the 'ollama' CLI isn't installed."
      bold "Get Ollama running to continue (it uses your GPU):"
      echo "  1. Install it — Mac / Windows / Linux: https://ollama.com/download"
      echo "  2. Open the Ollama app (or run 'ollama serve')."
      echo "  3. Leave it running — this continues automatically once it's up."
    fi
    echo
    printf "Waiting for Ollama on localhost:11434"
    until native_ollama_up; do printf "."; sleep 2; done
    echo
    ok "Ollama is up."
  fi
  ensure_ollama_lan_bind
}
setup_native_ollama() {
  ensure_native_ollama
  if ! native_has_model "$MODEL_SERVER_MODEL"; then
    bold "Pulling '$MODEL_SERVER_MODEL' into Ollama (one-time)..."
    if command -v ollama >/dev/null 2>&1; then
      ollama pull "$MODEL_SERVER_MODEL" || true
    else
      dim "(downloading via API — install the ollama CLI for a progress bar)"
      curl -fsS -X POST http://localhost:11434/api/pull \
        -d "{\"name\":\"$MODEL_SERVER_MODEL\"}" >/dev/null || true
    fi
    if ! native_has_model "$MODEL_SERVER_MODEL"; then
      err "'$MODEL_SERVER_MODEL' isn't available in Ollama after pulling."
      err "Check the name (browse: https://ollama.com/search?c=vision) and run:"
      err "  ollama pull $MODEL_SERVER_MODEL"
      exit 1
    fi
  fi
  ok "Model '$MODEL_SERVER_MODEL' ready on native Ollama (GPU)."
}

# ----- preflight: docker -----------------------------------------------------
if ! command -v docker >/dev/null 2>&1; then
  err "Docker is not installed."
  echo "Install Docker Desktop (Mac/Windows) or Docker Engine (Linux):"
  echo "  https://docs.docker.com/get-docker/"
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  err "Docker is installed but the daemon isn't running. Start Docker and re-run."
  exit 1
fi
if ! docker compose version >/dev/null 2>&1; then
  err "This needs Docker Compose v2 (the 'docker compose' subcommand). Update Docker."
  exit 1
fi

touch .cli-cache

GATEWAY_PORT="$(env_get GATEWAY_PORT)"; GATEWAY_PORT="${GATEWAY_PORT:-8443}"
bold "=== Photo Gallery — model server ==="
dim "Serving the tagging LLM (Ollama) + vision-server (faces/dogs) to other"
dim "machines on your LAN, behind one token-protected port. Nothing is ingested here."

# Token: reuse the saved one, or mint a fresh 24-byte hex token.
GATEWAY_TOKEN="$(env_get GATEWAY_TOKEN)"
if [[ -z "$GATEWAY_TOKEN" ]]; then
  GATEWAY_TOKEN="$(openssl rand -hex 24 2>/dev/null \
    || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  ok "Generated a new gateway token."
fi
export GATEWAY_TOKEN GATEWAY_PORT
env_set GATEWAY_TOKEN "$GATEWAY_TOKEN"

# Vision model to serve (pulled into native Ollama for tagging clients).
dmodel="$(env_get MODEL_SERVER_MODEL)"; dmodel="${dmodel:-qwen3-vl:8b}"
dim "Vision model to serve — Ollama 'name:tag' (browse: https://ollama.com/search?c=vision)."
export MODEL_SERVER_MODEL="$(ask "Vision model [$dmodel]: " "$dmodel")"
env_set MODEL_SERVER_MODEL "$MODEL_SERVER_MODEL"

# Native, GPU-backed Ollama: ensure it's up and the model is pulled (up front).
echo
bold "Setting up the tagging model (native Ollama)..."
setup_native_ollama

# Build + start vision-server and the gateway (server profile only).
echo
bold "Starting vision-server + gateway..."
dim "(building images — first time is slow; --verbose for full logs)"
compose_build vision-server gateway
# --force-recreate so a changed (bind-mounted) Caddyfile or rebuilt vision-server
# image is actually picked up — a plain `up` would leave the old containers (and
# the old config) running. Cheap; this box is started rarely.
docker compose --profile server up -d --remove-orphans --force-recreate vision-server gateway

# Gate on the gateway answering, then confirm Ollama is reachable THROUGH it.
printf "Waiting for gateway on :%s" "$GATEWAY_PORT"
tries=0
until curl -fsS "http://localhost:${GATEWAY_PORT}/health" >/dev/null 2>&1; do
  if [[ $tries -lt 30 ]]; then printf "."; sleep 1; tries=$((tries + 1)); continue; fi
  echo
  err "Gateway didn't come up. Inspect: docker compose --profile server logs gateway"
  exit 1
done
echo; ok "Gateway up."
if ! curl -fsS -H "Authorization: Bearer $GATEWAY_TOKEN" \
      "http://localhost:${GATEWAY_PORT}/api/tags" >/dev/null 2>&1; then
  echo
  err "Gateway is up but can't reach the native Ollama at host.docker.internal:11434."
  err "ensure_ollama_lan_bind should have bound it to 0.0.0.0 — check the Ollama app"
  err "and your firewall, then re-run ./model-server."
  docker compose --profile server stop vision-server gateway >/dev/null 2>&1 || true
  exit 1
fi

ip="$(lan_ip)"; ip="${ip:-<this-machine-LAN-IP>}"

# Ctrl-C (or closing the terminal) stops the servers.
trap 'echo; dim "Stopping model server..."; docker compose --profile server stop vision-server gateway >/dev/null 2>&1 || true; exit 0' INT TERM HUP

echo
bold "Model server running. On your MAIN machine run ./ingest-and-sync and enter:"
echo "  Tagging model host : http://$ip:${GATEWAY_PORT}"
echo "  Gateway token      : $GATEWAY_TOKEN"
echo
dim "Only port ${GATEWAY_PORT} is exposed, and it requires the token. The token"
dim "crosses the LAN in cleartext — fine on a trusted home network; tunnel it"
dim "(VPN/SSH) on anything less."
echo

if [[ "$VERBOSE" == true ]]; then
  bold "Streaming live request logs — Ctrl-C to stop the server."
  dim "Each tag / face / dog request from the main machine shows up below:"
  dim "  [faces] #N: K face(s) …   [dogs] #N: K dog(s) …   POST /v1/chat/… (tagging)"
  dim "Clustering runs on the MAIN machine, not here — it won't appear in these logs."
  echo
  # --since 0s skips replaying startup; -f blocks and follows until Ctrl-C, which
  # the trap above catches to stop the containers.
  docker compose --profile server logs -f --since 0s vision-server gateway
else
  dim "Watch live requests anytime with --verbose, or in another terminal:"
  dim "  docker compose --profile server logs -f vision-server gateway"
  echo
  bold "Leave this running. Press Ctrl-C to stop the server."
  # Block quietly so the address + token stay on screen (streaming would scroll
  # them off). The trap stops the containers on Ctrl-C.
  while true; do sleep 3600; done
fi
